# ── Required ─────────────────────────────────────────────
DISCORD_BOT_TOKEN=
MAIN_ADMIN_ID=            # your Discord user ID (owner)

# ── Web terminal / links ─────────────────────────────────
# Leave empty to auto-detect (public IP, else LAN IP).
SERVER_PUBLIC_IP=
# Public URL users open for /console. Recommended for private IPs / NAT:
# a Cloudflare Tunnel pointing to http://localhost:8765  ->  https://term.example.com
WEB_BASE_URL=
WEB_PORT=8765
# WEB_BIND=127.0.0.1      # use this if only a tunnel/reverse proxy should reach it

# ── Cluster ──────────────────────────────────────────────
LOCAL_NODE_NAME=Node-1

# ── Optional tuning ──────────────────────────────────────
# MAX_VPS_PER_USER=3
# DAILY_CREDITS=25        # 0 disables /daily
# AUTO_UPGRADE=1          # apt upgrade during deploy
# ENABLE_SSHX=1
# ENABLE_TMATE=1
# SYNC_GUILD_ID=          # your server ID for instant slash-command updates
# ENABLE_MESSAGE_CONTENT=0  # 1 = also enable "!" prefix commands (needs Message Content Intent)
# PAIR_SECRET=            # worker pairing secret (auto-generated if empty)
